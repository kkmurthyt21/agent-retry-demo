{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devfest:agent-event:1.1",
  "title": "DevFest agent event 1.1",
  "type": "object",
  "required": [
    "eventId",
    "workflowId",
    "correlationId",
    "causationId",
    "idempotencyKey",
    "source",
    "eventType",
    "schemaVersion",
    "expectedStateVersion",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "workflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "causationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source": {
      "enum": [
        "planner",
        "executor",
        "verifier"
      ]
    },
    "eventType": {
      "enum": [
        "TaskPlanned",
        "ActionCompleted",
        "WorkflowVerified"
      ]
    },
    "schemaVersion": {
      "const": "1.1"
    },
    "expectedStateVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "TaskPlanned"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "const": "planner"
          },
          "data": {
            "type": "object",
            "required": [
              "action",
              "debitAccountRef",
              "beneficiaryRef",
              "amountMinor",
              "currency",
              "route"
            ],
            "properties": {
              "action": {
                "const": "SUBMIT_PAYMENT_INSTRUCTION"
              },
              "debitAccountRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "beneficiaryRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "amountMinor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000000
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "route": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "clientReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "ActionCompleted"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "const": "executor"
          },
          "data": {
            "type": "object",
            "required": [
              "instructionId",
              "status"
            ],
            "properties": {
              "instructionId": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "ACCEPTED"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "WorkflowVerified"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "const": "verifier"
          },
          "data": {
            "type": "object",
            "required": [
              "instructionId",
              "verified"
            ],
            "properties": {
              "instructionId": {
                "type": "string",
                "minLength": 1
              },
              "verified": {
                "const": true
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
